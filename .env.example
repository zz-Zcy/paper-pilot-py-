# PaperPilot API 配置
# 复制此文件为 .env，填入你的 API Key

# 选择 LLM 提供商：deepseek | openai
LLM_PROVIDER=deepseek

# DeepSeek API（推荐，国内速度快，价格便宜）
# 1. 注册：https://platform.deepseek.com
# 2. 创建 API Key，替换下方 sk-xxx
DEEPSEEK_API_KEY=sk-你的DeepSeekAPIKey
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API（可选，效果更强但更贵）
# 1. 注册：https://platform.openai.com
# 2. 创建 API Key，取消注释并替换下方 sk-xxx
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-你的OpenAIAPIKey
# OPENAI_MODEL=gpt-4o-mini